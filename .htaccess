# Protection pour le cas ou ce dossier est deploye tel quel sous le
# document root de l'hebergeur (ex: public_html/G_universite/) au lieu
# de pointer directement sur le dossier "public". Bloque l'acces direct
# a tout ce qui ne doit pas etre expose publiquement.
RewriteEngine On

RewriteCond %{REQUEST_URI} ^.*/(app|vendor|\.git|\.sixth|\.vscode)/ [NC,OR]
RewriteCond %{REQUEST_URI} /(composer\.json|composer\.lock|config\.sample\.php|\.gitignore|HEBERGEMENT\.md)$ [NC]
RewriteRule ^ - [F,L]

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
